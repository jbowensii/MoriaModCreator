<?xml version="1.0" encoding="UTF-8"?>
<definition>
  <title>Mereaks Secrets_MODIFY DT_Tools</title>
  <author>Moria MOD Creator</author>
  <description>3 modifications to DT_Tools.json</description>
  <mod file="Moria\Content\Tech\Data\Items\DT_Tools.json">
    <change item="Restoration_Hammer_Tobi" property="DurabilityDecayWhileEquipped" value="0.0" />
    <change item="Restoration_Hammer_Tobi" property="StaminaCost" value="0.0" />
    <change item="Restoration_Hammer_Tobi" property="InitialRepairCost[0].MaterialHandle.RowName" value="Item.MithrilIngot" />
  </mod>
</definition>