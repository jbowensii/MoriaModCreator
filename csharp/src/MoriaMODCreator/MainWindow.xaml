<Window x:Class="MoriaMODCreator.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:MoriaMODCreator.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance vm:MainViewModel}"
        Title="{Binding Title}"
        Height="900" Width="500"
        MinHeight="700" MinWidth="450"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundBrush}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="20,15,20,5">
            <!-- App icon placeholder -->
            <TextBlock Text="&#x2692;" FontSize="36" VerticalAlignment="Center" Margin="0,0,12,0"
                       Foreground="{StaticResource AccentBrush}"/>
            <TextBlock Text="Moria MOD Creator" FontSize="28" FontWeight="Bold"
                       VerticalAlignment="Center" Foreground="{StaticResource TextBrush}"/>
        </StackPanel>

        <!-- Tab Control -->
        <TabControl Grid.Row="1" Margin="10,5,10,10"
                    SelectedIndex="{Binding SelectedTabIndex}"
                    Background="{StaticResource BackgroundBrush}">

            <!-- Novice Mode Tab -->
            <TabItem Header="Novice Mode">
                <Grid Background="{StaticResource BackgroundBrush}">
                    <TextBlock Text="Novice Mode - Coming Soon"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               FontSize="18" Foreground="{StaticResource TextSecondaryBrush}"/>
                </Grid>
            </TabItem>

            <!-- Advanced Mode Tab -->
            <TabItem Header="Advanced Mode">
                <Grid Background="{StaticResource BackgroundBrush}">
                    <TextBlock Text="Advanced Mode - Coming Soon"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               FontSize="18" Foreground="{StaticResource TextSecondaryBrush}"/>
                </Grid>
            </TabItem>

            <!-- Change Secrets Tab -->
            <TabItem Header="Change Secrets">
                <Grid Background="{StaticResource BackgroundBrush}">
                    <TextBlock Text="Change Secrets - Coming Soon"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               FontSize="18" Foreground="{StaticResource TextSecondaryBrush}"/>
                </Grid>
            </TabItem>

            <!-- Change Constructions Tab -->
            <TabItem Header="Change Constructions">
                <Grid Background="{StaticResource BackgroundBrush}">
                    <TextBlock Text="Change Constructions - Coming Soon"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               FontSize="18" Foreground="{StaticResource TextSecondaryBrush}"/>
                </Grid>
            </TabItem>

            <!-- Object Editor Tab -->
            <TabItem Header="Object Editor">
                <Grid Background="{StaticResource BackgroundBrush}">
                    <TextBlock Text="Object Editor - Coming Soon"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               FontSize="18" Foreground="{StaticResource TextSecondaryBrush}"/>
                </Grid>
            </TabItem>

            <!-- Create DEF Tab -->
            <TabItem Header="Create DEF">
                <Grid Background="{StaticResource BackgroundBrush}">
                    <TextBlock Text="Create DEF - Coming Soon"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               FontSize="18" Foreground="{StaticResource TextSecondaryBrush}"/>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
