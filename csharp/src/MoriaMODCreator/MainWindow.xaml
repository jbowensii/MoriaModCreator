<Window x:Class="MoriaMODCreator.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="clr-namespace:MoriaMODCreator.Views"
        mc:Ignorable="d"
        Title="Moria MOD Creator"
        Height="900" Width="900"
        MinHeight="700" MinWidth="700"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundBrush}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- Header + toolbar -->
            <RowDefinition Height="*"/>     <!-- Main content area -->
            <RowDefinition Height="Auto"/>  <!-- Status bar -->
        </Grid.RowDefinitions>

        <!-- ===== HEADER BAR ===== -->
        <Border Grid.Row="0" Background="{StaticResource SurfaceBrush}" Padding="15,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>  <!-- Title -->
                    <ColumnDefinition Width="*"/>     <!-- Toolbar buttons (center) -->
                    <ColumnDefinition Width="Auto"/>  <!-- Mode toggle + settings -->
                </Grid.ColumnDefinitions>

                <!-- LEFT: App title -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="&#x2692;" FontSize="28" VerticalAlignment="Center"
                               Margin="0,0,10,0" Foreground="{StaticResource AccentBrush}"/>
                    <TextBlock Text="Moria MOD Creator" FontSize="22" FontWeight="Bold"
                               VerticalAlignment="Center" Foreground="{StaticResource TextBrush}"/>
                </StackPanel>

                <!-- CENTER: Toolbar buttons -->
                <StackPanel Grid.Column="1" x:Name="ToolbarPanel" Orientation="Horizontal"
                            HorizontalAlignment="Center" VerticalAlignment="Center">
                    <!-- These buttons are shown/hidden by mode -->
                    <Button x:Name="ModBuilderBtn" Content="Mod Builder"
                            Style="{StaticResource ToolbarButton}"
                            Background="{StaticResource PrimaryBrush}"
                            Click="OnModBuilderClick" Margin="3,0"/>
                    <Button x:Name="SecretsBtn" Content="Secrets"
                            Style="{StaticResource ToolbarButton}"
                            Background="{StaticResource ButtonInactiveBrush}"
                            Click="OnSecretsClick" Margin="3,0"/>
                    <Button x:Name="ObjectEditorBtn" Content="Create/Edit Secret"
                            Style="{StaticResource ToolbarButton}" MinWidth="140"
                            Background="{StaticResource ButtonInactiveBrush}"
                            Click="OnObjectEditorClick" Margin="3,0"/>
                    <Button x:Name="ConstructionsBtn" Content="Constructions"
                            Style="{StaticResource ToolbarButton}"
                            Background="{StaticResource ButtonInactiveBrush}"
                            Click="OnConstructionsClick" Margin="3,0"/>
                    <Button x:Name="CreateDefBtn" Content="Create DEF"
                            Style="{StaticResource ToolbarButton}"
                            Background="{StaticResource ButtonInactiveBrush}"
                            Click="OnCreateDefClick" Margin="3,0"/>
                    <TextBlock x:Name="ToolbarSep" Text="|" Foreground="Gray"
                               FontSize="20" VerticalAlignment="Center" Margin="8,0"/>
                    <Button x:Name="ImportBtn" Content="Import"
                            Style="{StaticResource ToolbarButton}"
                            Background="{StaticResource ImportBrush}"
                            Click="OnImportClick" Margin="3,0"/>
                </StackPanel>

                <!-- RIGHT: Mode toggle + Settings + Help -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Margin="0,0,10,0">
                        <ToggleButton x:Name="NoviceToggle" Content="Novice"
                                      Style="{StaticResource ModeToggle}"
                                      IsChecked="True" Click="OnNoviceToggle"/>
                        <ToggleButton x:Name="AdvancedToggle" Content="Advanced"
                                      Style="{StaticResource ModeToggle}"
                                      Click="OnAdvancedToggle" Margin="2,0,0,0"/>
                    </StackPanel>
                    <Button Content="&#x2699;" Padding="8,6" FontSize="16"
                            Background="Transparent" ToolTip="Settings"
                            Click="OnSettingsClick"/>
                    <Button Content="&#x2753;" Padding="8,6" FontSize="16"
                            Background="Transparent" ToolTip="About"
                            Click="OnAboutClick" Margin="3,0,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ===== MAIN CONTENT AREA ===== -->
        <Grid Grid.Row="1" Margin="10">
            <!-- Novice View (shown in Novice mode) -->
            <views:NoviceView x:Name="NoviceTab" Visibility="Visible"/>

            <!-- Advanced: Definitions View (shown in Advanced/Mod Builder mode) -->
            <views:DefinitionsView x:Name="DefinitionsTab" Visibility="Collapsed"/>

            <!-- Advanced: Change Secrets View -->
            <views:BuildingsView x:Name="SecretsTab" Visibility="Collapsed"/>

            <!-- Advanced: Change Constructions View -->
            <views:BuildingsView x:Name="ConstructionsTab" Visibility="Collapsed"/>

            <!-- Advanced: Object Editor (placeholder) -->
            <views:PlaceholderView x:Name="ObjectEditorTab" Visibility="Collapsed"/>

            <!-- Advanced: Create DEF (placeholder) -->
            <views:PlaceholderView x:Name="CreateDefTab" Visibility="Collapsed"/>
        </Grid>

        <!-- ===== STATUS BAR ===== -->
        <Border Grid.Row="2" Background="{StaticResource SurfaceBrush}" Padding="15,8">
            <TextBlock x:Name="StatusText" Text="" FontSize="12"
                       Foreground="{StaticResource TextSecondaryBrush}"/>
        </Border>
    </Grid>
</Window>
