<UserControl x:Class="MoriaMODCreator.Views.NoviceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:MoriaMODCreator.ViewModels"
             d:DataContext="{d:DesignInstance vm:NoviceViewModel}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             Background="{StaticResource BackgroundBrush}">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*"/>
            <ColumnDefinition Width="3*"/>
        </Grid.ColumnDefinitions>

        <!-- ===== LEFT PANE: Prebuilt Mod List ===== -->
        <Border Grid.Column="0" Background="{StaticResource SurfaceBrush}"
                CornerRadius="6" Margin="0,0,5,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Header -->
                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="10,10,10,5">
                    <CheckBox Content="" VerticalAlignment="Center" Margin="0,0,8,0"
                              Command="{Binding SelectAllCommand}"/>
                    <TextBlock Text="Prebuilt Mods" FontSize="14" FontWeight="Bold"
                               Foreground="{StaticResource TextBrush}" VerticalAlignment="Center"/>
                    <Button Content="&#x21BB;" Command="{Binding LoadModsCommand}"
                            Margin="10,0,0,0" Padding="6,3" FontSize="14"
                            Background="Transparent" ToolTip="Refresh"/>
                </StackPanel>

                <!-- Mod list -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="5,0">
                    <ItemsControl ItemsSource="{Binding Mods}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="Transparent" Margin="0,1" Padding="8,6"
                                        Cursor="Hand">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <CheckBox Grid.Column="0" IsChecked="{Binding IsChecked}"
                                                  VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Title}" FontSize="13"
                                                   Foreground="#FFD700" VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <Button Grid.Column="2" Content="&#x1F5D1;"
                                                Background="{StaticResource DeleteBrush}"
                                                Padding="6,3" FontSize="11"
                                                VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <!-- Bottom: Mod name + Build -->
                <Grid Grid.Row="2" Margin="10,5,10,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Content="My Mod Name"
                            Background="{StaticResource AccentBrush}"
                            Padding="10,6" FontSize="12"/>
                    <TextBox Grid.Column="1" Text="{Binding ModName, UpdateSourceTrigger=PropertyChanged}"
                             Margin="6,0" VerticalAlignment="Center" FontSize="12"/>
                    <Button Grid.Column="2" Content="Build"
                            Background="{StaticResource BuildBrush}"
                            Command="{Binding BuildCommand}" Padding="14,6" FontSize="12"/>
                </Grid>
            </Grid>
        </Border>

        <!-- ===== RIGHT PANE: Mod Description / Info ===== -->
        <Border Grid.Column="1" Background="{StaticResource SurfaceBrush}"
                CornerRadius="6" Margin="5,0,0,0">
            <Grid Margin="15">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Title area -->
                <TextBlock Grid.Row="0" Text="Mod Information" FontSize="18" FontWeight="Bold"
                           Foreground="{StaticResource TextBrush}" Margin="0,0,0,10"/>

                <!-- Build progress -->
                <StackPanel Grid.Row="1" Margin="0,0,0,10"
                            Visibility="{Binding IsBuilding, Converter={StaticResource BoolToVisibilityConverter}}">
                    <ProgressBar Value="{Binding BuildProgress}" Maximum="1" Height="8" Margin="0,0,0,5"/>
                    <TextBlock Text="{Binding BuildStatus}" FontSize="12"
                               Foreground="{StaticResource TextSecondaryBrush}"/>
                </StackPanel>

                <!-- Description / help content area -->
                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock TextWrapping="Wrap" FontSize="14" LineHeight="22"
                                   Foreground="{StaticResource TextBrush}">
                            <Run FontWeight="Bold" FontSize="16">Welcome to Moria MOD Creator</Run>
                            <LineBreak/><LineBreak/>
                            <Run>Select prebuilt mods from the list on the left, enter a mod name, and click Build to create your mod.</Run>
                            <LineBreak/><LineBreak/>
                            <Run FontWeight="Bold">Getting Started:</Run>
                            <LineBreak/>
                            <Run>1. Click Import to extract game files</Run>
                            <LineBreak/>
                            <Run>2. Check the mods you want to include</Run>
                            <LineBreak/>
                            <Run>3. Enter a name for your mod</Run>
                            <LineBreak/>
                            <Run>4. Click Build to create your mod package</Run>
                            <LineBreak/><LineBreak/>
                            <Run FontWeight="Bold">Advanced Mode:</Run>
                            <LineBreak/>
                            <Run>Switch to Advanced mode using the toggle in the top right to access the full mod builder with definition editing, secrets management, and custom mod creation tools.</Run>
                        </TextBlock>
                    </StackPanel>
                </ScrollViewer>

                <!-- Status when not building -->
                <TextBlock Grid.Row="3" Text="{Binding BuildStatus}" FontSize="12"
                           Foreground="{StaticResource TextSecondaryBrush}" Margin="0,10,0,0"
                           Visibility="{Binding IsBuilding, Converter={StaticResource InverseBoolToVisibilityConverter}}"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
