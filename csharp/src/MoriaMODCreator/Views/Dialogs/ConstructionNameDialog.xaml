<Window x:Class="MoriaMODCreator.Views.Dialogs.ConstructionNameDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Construction Name"
        Height="200" Width="400"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Icon="/Assets/Icons/app_icon.ico"
        Background="{StaticResource BackgroundBrush}">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Enter a name for this construction set:"
                   FontSize="14" Foreground="{StaticResource TextBrush}" Margin="0,0,0,10"/>

        <TextBox Grid.Row="1" x:Name="NameBox" FontSize="14" Padding="10,8"
                 KeyDown="OnKeyDown"/>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
            <Button Content="Cancel" Padding="16,8" Click="OnCancel" Margin="0,0,8,0"/>
            <Button Content="OK" Padding="16,8" Background="{StaticResource BuildBrush}"
                    Click="OnOk"/>
        </StackPanel>
    </Grid>
</Window>
