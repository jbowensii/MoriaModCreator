<Window x:Class="MoriaMODCreator.Views.Dialogs.AboutDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="About Moria MOD Creator"
        Height="550" Width="900"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Icon="/Assets/Icons/app_icon.ico"
        Background="{StaticResource BackgroundBrush}">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="440"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- LEFT: Character image (Mereak Firmaxe, bottom-aligned) -->
        <Grid Grid.Column="0">
            <Image Source="/Assets/Images/MereakFirmaxe.png"
                   VerticalAlignment="Bottom" HorizontalAlignment="Left"
                   RenderOptions.BitmapScalingMode="HighQuality"
                   Stretch="Uniform" MaxHeight="500">
                <Image.RenderTransform>
                    <ScaleTransform ScaleX="-1" CenterX="220"/>
                </Image.RenderTransform>
            </Image>
        </Grid>

        <!-- RIGHT: Button bar + scrollable content -->
        <Grid Grid.Column="1" Margin="5,10,10,10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Button bar -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                <Button x:Name="AboutBtn" Content="About" Padding="14,6" FontSize="12"
                        Background="#1a5fb4" Click="OnAboutTab" Margin="0,0,5,0"/>
                <Button x:Name="DisclaimerBtn" Content="Disclaimer" Padding="14,6" FontSize="12"
                        Background="Gray" Click="OnDisclaimerTab" Margin="0,0,5,0"/>
                <Button x:Name="CreditsBtn" Content="Credits" Padding="14,6" FontSize="12"
                        Background="Gray" Click="OnCreditsTab" Margin="0,0,5,0"/>
                <Button Content="Close" Padding="14,6" FontSize="12"
                        Background="#c01c28" Click="OnClose"
                        HorizontalAlignment="Right" Margin="20,0,0,0"/>
            </StackPanel>

            <!-- Scrollable content area -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel x:Name="ContentPanel" Margin="10">
                    <!-- Content populated by code-behind -->
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
