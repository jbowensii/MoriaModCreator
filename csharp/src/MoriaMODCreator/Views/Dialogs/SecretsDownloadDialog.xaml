<Window x:Class="MoriaMODCreator.Views.Dialogs.SecretsDownloadDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Secrets ZIP Required" Height="400" Width="550"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{StaticResource BackgroundBrush}"
        AllowDrop="True" Drop="OnDrop" DragOver="OnDragOver">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Title -->
        <TextBlock Grid.Row="0" Text="Secrets of Khazad-Dum ZIP Required" FontSize="16" FontWeight="Bold"
                   Foreground="{StaticResource TextBrush}" Margin="0,0,0,10"/>

        <!-- Instructions -->
        <TextBlock Grid.Row="1" TextWrapping="Wrap" FontSize="13"
                   Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,12">
            Download the "Secrets of Khazad-Dum" mod ZIP from Nexus Mods.
            Then browse to select it, or drag and drop it onto this window.
            The GitHub JSON data will be downloaded automatically after this step.
        </TextBlock>

        <!-- Browse button + path -->
        <Grid Grid.Row="2" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="ZipPathBox" IsReadOnly="True" FontSize="12"/>
            <Button Grid.Column="1" Content="Browse for ZIP..." Click="OnBrowse"
                    Padding="12,6" FontSize="12" Margin="6,0,0,0"/>
        </Grid>

        <!-- Drop zone visual indicator -->
        <Border Grid.Row="3" BorderBrush="{StaticResource AccentBrush}" BorderThickness="2"
                CornerRadius="6" Padding="15" Margin="0,0,0,10"
                Background="Transparent" MinHeight="60">
            <TextBlock Text="&#x2B07;  Drop ZIP file here  &#x2B07;" FontSize="14"
                       Foreground="{StaticResource TextSecondaryBrush}"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>

        <!-- Status -->
        <ScrollViewer Grid.Row="4" VerticalScrollBarVisibility="Auto">
            <TextBlock x:Name="StatusText" FontSize="12" TextWrapping="Wrap"
                       Foreground="{StaticResource TextSecondaryBrush}"/>
        </ScrollViewer>

        <!-- Buttons -->
        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Skip Secrets" Click="OnSkip"
                    Padding="12,6" FontSize="12" Margin="0,0,6,0"
                    Background="{StaticResource ButtonInactiveBrush}"/>
            <Button Content="Continue" Click="OnImport" x:Name="ImportBtn"
                    Padding="12,6" FontSize="12" IsEnabled="False"
                    Background="{StaticResource BuildBrush}"/>
        </StackPanel>
    </Grid>
</Window>
