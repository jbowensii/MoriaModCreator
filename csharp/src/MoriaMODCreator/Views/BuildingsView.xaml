<UserControl x:Class="MoriaMODCreator.Views.BuildingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:MoriaMODCreator.ViewModels"
             xmlns:models="clr-namespace:MoriaMODCreator.Models"
             xmlns:conv="clr-namespace:MoriaMODCreator.Converters"
             d:DataContext="{d:DesignInstance vm:BuildingsViewModel}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             Background="{StaticResource BackgroundBrush}">

    <UserControl.Resources>
        <conv:NullTooltipConverter x:Key="NullTooltipConverter"/>
        <conv:StringToBrushConverter x:Key="StringToBrushConverter"/>

        <!-- Template selector for form fields -->
        <conv:FormFieldTemplateSelector x:Key="FieldTemplateSelector">
            <!-- Section Header -->
            <conv:FormFieldTemplateSelector.SectionHeaderTemplate>
                <DataTemplate DataType="{x:Type models:FormField}">
                    <StackPanel Margin="0,12,0,4">
                        <TextBlock Text="{Binding Label}" FontSize="14" FontWeight="Bold"
                                   Foreground="{Binding SectionColor}" Margin="0,0,0,3"/>
                        <Border Height="1" Background="{Binding SectionColor}" Opacity="0.5"/>
                    </StackPanel>
                </DataTemplate>
            </conv:FormFieldTemplateSelector.SectionHeaderTemplate>

            <!-- Text Field -->
            <conv:FormFieldTemplateSelector.TextFieldTemplate>
                <DataTemplate DataType="{x:Type models:FormField}">
                    <Grid Margin="0,3,0,3">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="180"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding Label}" FontSize="12"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   VerticalAlignment="Center"
                                   ToolTip="{Binding Tooltip, Converter={StaticResource NullTooltipConverter}}"/>
                        <TextBox Grid.Column="1" Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                                 FontSize="12" IsReadOnly="{Binding IsReadOnly}"/>
                    </Grid>
                </DataTemplate>
            </conv:FormFieldTemplateSelector.TextFieldTemplate>

            <!-- Dropdown Field -->
            <conv:FormFieldTemplateSelector.DropdownFieldTemplate>
                <DataTemplate DataType="{x:Type models:FormField}">
                    <Grid Margin="0,3,0,3">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="180"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding Label}" FontSize="12"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   VerticalAlignment="Center"
                                   ToolTip="{Binding Tooltip, Converter={StaticResource NullTooltipConverter}}"/>
                        <ComboBox Grid.Column="1" Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                                  ItemsSource="{Binding Options}" IsEditable="True" FontSize="12"/>
                    </Grid>
                </DataTemplate>
            </conv:FormFieldTemplateSelector.DropdownFieldTemplate>

            <!-- Checkbox Field -->
            <conv:FormFieldTemplateSelector.CheckboxFieldTemplate>
                <DataTemplate DataType="{x:Type models:FormField}">
                    <CheckBox Content="{Binding Label}" FontSize="12"
                              Foreground="{StaticResource TextBrush}"
                              Margin="0,2,12,2" ToolTip="{Binding Tooltip, Converter={StaticResource NullTooltipConverter}}">
                        <CheckBox.IsChecked>
                            <Binding Path="Value" UpdateSourceTrigger="PropertyChanged">
                                <Binding.Converter>
                                    <conv:StringToBoolConverter/>
                                </Binding.Converter>
                            </Binding>
                        </CheckBox.IsChecked>
                    </CheckBox>
                </DataTemplate>
            </conv:FormFieldTemplateSelector.CheckboxFieldTemplate>

            <!-- Inline Row (multiple fields horizontally) -->
            <conv:FormFieldTemplateSelector.InlineRowTemplate>
                <DataTemplate DataType="{x:Type models:FormField}">
                    <ItemsControl ItemsSource="{Binding InlineFields}" Margin="0,3,0,3">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Rows="1"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type models:FormField}">
                                <StackPanel Margin="0,0,8,0">
                                    <TextBlock Text="{Binding Label}" FontSize="10"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               ToolTip="{Binding Tooltip, Converter={StaticResource NullTooltipConverter}}"/>
                                    <TextBox Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                                             FontSize="12" Margin="0,2,0,0"/>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </DataTemplate>
            </conv:FormFieldTemplateSelector.InlineRowTemplate>

            <!-- ReadOnly Field -->
            <conv:FormFieldTemplateSelector.ReadOnlyFieldTemplate>
                <DataTemplate DataType="{x:Type models:FormField}">
                    <Grid Margin="0,3,0,3">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="180"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding Label}" FontSize="12"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   VerticalAlignment="Center"
                                   ToolTip="{Binding Tooltip, Converter={StaticResource NullTooltipConverter}}"/>
                        <TextBox Grid.Column="1" Text="{Binding Value}" FontSize="12"
                                 IsReadOnly="True" Opacity="0.7"/>
                    </Grid>
                </DataTemplate>
            </conv:FormFieldTemplateSelector.ReadOnlyFieldTemplate>
        </conv:FormFieldTemplateSelector>
    </UserControl.Resources>

    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*" MinWidth="200"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="3*"/>
        </Grid.ColumnDefinitions>

        <!-- ===== LEFT PANE ===== -->
        <Border Grid.Column="0" Background="{StaticResource SurfaceBrush}"
                CornerRadius="6" Margin="0,0,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>  <!-- Category buttons -->
                    <RowDefinition Height="Auto"/>  <!-- Include + Refresh + Eye -->
                    <RowDefinition Height="*"/>     <!-- Item list -->
                    <RowDefinition Height="Auto"/>  <!-- Search bar (bottom, like Python) -->
                    <RowDefinition Height="Auto"/>  <!-- Count -->
                    <RowDefinition Height="Auto"/>  <!-- Prefix + Build -->
                </Grid.RowDefinitions>

                <!-- Category buttons with per-category colors -->
                <StackPanel Grid.Row="0" Margin="5,5,5,5">
                    <WrapPanel>
                        <Button Content="Buildings" Command="{Binding SelectCategoryCommand}" CommandParameter="Buildings"
                                Margin="2" Padding="8,4" FontSize="11" Background="#795548" x:Name="BtnBuildings"/>
                        <Button Content="Weapons" Command="{Binding SelectCategoryCommand}" CommandParameter="Weapons"
                                Margin="2" Padding="8,4" FontSize="11" Background="#E65100" x:Name="BtnWeapons"/>
                        <Button Content="Armor" Command="{Binding SelectCategoryCommand}" CommandParameter="Armor"
                                Margin="2" Padding="8,4" FontSize="11" Background="#1565C0" x:Name="BtnArmor"/>
                    </WrapPanel>
                    <WrapPanel>
                        <Button Content="Tools" Command="{Binding SelectCategoryCommand}" CommandParameter="Tools"
                                Margin="2" Padding="8,4" FontSize="11" Background="#2E7D32" x:Name="BtnTools"/>
                        <Button Content="Flora" Command="{Binding SelectCategoryCommand}" CommandParameter="Flora"
                                Margin="2" Padding="8,4" FontSize="11" Background="#388E3C" x:Name="BtnFlora"/>
                    </WrapPanel>
                    <WrapPanel>
                        <Button Content="Loot" Command="{Binding SelectCategoryCommand}" CommandParameter="Loot"
                                Margin="2" Padding="8,4" FontSize="11" Background="#F57F17" x:Name="BtnLoot"/>
                        <Button Content="Items" Command="{Binding SelectCategoryCommand}" CommandParameter="Items"
                                Margin="2" Padding="8,4" FontSize="11" Background="#6A1B9A" x:Name="BtnItems"/>
                        <Button Content="Ores" Command="{Binding SelectCategoryCommand}" CommandParameter="Ores"
                                Margin="2" Padding="8,4" FontSize="11" Background="#795548" x:Name="BtnOres"/>
                    </WrapPanel>
                </StackPanel>

                <!-- Include Secrets + Refresh + Bulk Eye -->
                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="10,0,10,5">
                    <CheckBox Content="Include Secrets" IsChecked="{Binding IncludeSecrets}"
                              FontSize="10" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <Button Content="&#x21BB;" Command="{Binding RefreshCacheCommand}"
                            Padding="6,3" FontSize="14" Background="Transparent" ToolTip="Refresh Cache"/>
                    <Button Content="{Binding BulkEyeIcon}" Command="{Binding ToggleBulkVisibilityCommand}"
                            Padding="6,3" FontSize="14" Background="Transparent" ToolTip="Toggle All Visibility"
                            Foreground="{Binding BulkEyeColor, Converter={StaticResource StringToBrushConverter}}"
                            Margin="4,0,0,0"/>
                </StackPanel>

                <!-- Item list with checkboxes + eye icons -->
                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Margin="5,0">
                    <ItemsControl ItemsSource="{Binding FilteredItems}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource ListItemBorder}" Padding="4,3">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <CheckBox IsChecked="{Binding IsChecked}" VerticalAlignment="Center"
                                                  Margin="0,0,4,0"/>
                                        <!-- Eye icon: green=visible, red=hidden -->
                                        <TextBlock Grid.Column="1" Text="{Binding EyeIcon}" FontSize="12"
                                                   Foreground="{Binding EyeColor, Converter={StaticResource StringToBrushConverter}}"
                                                   VerticalAlignment="Center" Margin="0,0,4,0" Cursor="Hand">
                                            <TextBlock.InputBindings>
                                                <MouseBinding MouseAction="LeftClick"
                                                              Command="{Binding DataContext.ToggleItemVisibilityCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                              CommandParameter="{Binding}"/>
                                            </TextBlock.InputBindings>
                                        </TextBlock>
                                        <Border Grid.Column="2">
                                            <Border.InputBindings>
                                                <MouseBinding MouseAction="LeftClick"
                                                              Command="{Binding DataContext.SelectItemCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                              CommandParameter="{Binding}"/>
                                            </Border.InputBindings>
                                            <TextBlock FontSize="11" Foreground="#FFD700"
                                                       Text="{Binding DisplayName}"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <!-- Search bar at bottom (matching Python layout) with magnifying glass -->
                <Grid Grid.Row="3" Margin="10,5,10,2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="&#x1F50D;" FontSize="12" VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <TextBox Grid.Column="1" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             FontSize="11" Tag="Search definitions..."/>
                    <Button Grid.Column="2" Content="&#x2715;" Padding="4,2" FontSize="10"
                            Background="Transparent" Command="{Binding ClearSearchCommand}"
                            Margin="2,0,0,0" ToolTip="Clear search"/>
                </Grid>

                <!-- Count -->
                <TextBlock Grid.Row="4" Margin="10,0,10,2" FontSize="10"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           Text="{Binding ItemCountText}"/>

                <!-- Bottom: Prefix + Build -->
                <StackPanel Grid.Row="5" Margin="10,0,10,10">
                    <!-- Change Secrets / Change Constructions + prefix -->
                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Content="{Binding ModeLabel}" Command="{Binding ChoosePrefixCommand}"
                                Padding="6,4" FontSize="10" Background="{StaticResource AccentBrush}"/>
                        <TextBox Grid.Column="1" Text="{Binding Prefix, UpdateSourceTrigger=PropertyChanged}"
                                 Margin="4,0,0,0" FontSize="11" VerticalAlignment="Center" IsReadOnly="True"/>
                    </Grid>
                    <!-- Build button -->
                    <Button Content="Build" Command="{Binding BuildCommand}"
                            Background="{StaticResource BuildBrush}" Padding="8,6" FontSize="12"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Resizable splitter -->
        <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Center"
                      VerticalAlignment="Stretch" Background="Transparent" Cursor="SizeWE"/>

        <!-- ===== RIGHT PANE: Form Editor ===== -->
        <Border Grid.Column="2" Background="{StaticResource SurfaceBrush}"
                CornerRadius="6" Margin="5,0,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>  <!-- Search & Replace bar -->
                    <RowDefinition Height="Auto"/>  <!-- Header -->
                    <RowDefinition Height="*"/>     <!-- Form content -->
                    <RowDefinition Height="Auto"/>  <!-- Footer -->
                </Grid.RowDefinitions>

                <!-- Search & Replace bar -->
                <Border Grid.Row="0" Background="{StaticResource BackgroundBrush}"
                        Padding="8,4" Margin="10,10,10,0" CornerRadius="4"
                        Visibility="{Binding ShowPlaceholder, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" Text="{Binding FormSearchText, UpdateSourceTrigger=PropertyChanged}"
                                 FontSize="11" Margin="0,0,4,0"/>
                        <TextBox Grid.Column="1" Text="{Binding FormReplaceText, UpdateSourceTrigger=PropertyChanged}"
                                 FontSize="11" Margin="0,0,4,0"/>
                        <Button Grid.Column="2" Content="Find" Command="{Binding FormSearchCommand}"
                                Padding="8,3" FontSize="10" Margin="0,0,2,0"/>
                        <Button Grid.Column="3" Content="Replace All" Command="{Binding FormReplaceAllCommand}"
                                Padding="8,3" FontSize="10"/>
                    </Grid>
                </Border>

                <!-- Header: selected item name + eye icon (matching Python) -->
                <Grid Grid.Row="1" Margin="15,10,15,0"
                      Visibility="{Binding ShowPlaceholder, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="{Binding SelectedItem.DisplayName}" FontSize="18" FontWeight="Bold"
                                   Foreground="#FFD700"/>
                        <TextBlock Text="{Binding SelectedItem.RowName}" FontSize="11"
                                   Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0"/>
                    </StackPanel>
                    <!-- Header eye icon: click to toggle current item visibility -->
                    <Button Grid.Column="1" Content="{Binding SelectedItem.EyeIcon}"
                            Command="{Binding ToggleItemVisibilityCommand}"
                            CommandParameter="{Binding SelectedItem}"
                            FontSize="16" Background="Transparent" Padding="6,3"
                            Foreground="{Binding SelectedItem.EyeColor, Converter={StaticResource StringToBrushConverter}}"
                            VerticalAlignment="Top" ToolTip="Toggle item visibility"/>
                    <Border Grid.ColumnSpan="2" Height="1" Background="{StaticResource TextSecondaryBrush}"
                            Margin="0,8,0,0" Opacity="0.3" VerticalAlignment="Bottom"/>
                </Grid>

                <!-- Form content -->
                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Margin="15,5,15,5">
                    <Grid>
                        <!-- Placeholder when no item selected -->
                        <TextBlock Text="Select an item from the list to edit its properties."
                                   FontSize="14" Foreground="{StaticResource TextSecondaryBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Margin="0,40,0,0"
                                   Visibility="{Binding ShowPlaceholder, Converter={StaticResource BoolToVisibilityConverter}}"/>

                        <!-- Form fields -->
                        <StackPanel Visibility="{Binding ShowPlaceholder, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                            <!-- Form fields via template selector -->
                            <ItemsControl ItemsSource="{Binding FormFields}"
                                          ItemTemplateSelector="{StaticResource FieldTemplateSelector}"/>

                            <!-- Material sections -->
                            <ItemsControl ItemsSource="{Binding MaterialSections}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type models:MaterialSection}">
                                        <StackPanel Margin="0,12,0,4">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="Bold"
                                                           Foreground="#FF9800" Margin="0,0,10,3"/>
                                                <Button Content="+ Add" Padding="6,2" FontSize="10"
                                                        Background="#FF9800"
                                                        Command="{Binding DataContext.AddMaterialRowCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}"/>
                                            </StackPanel>
                                            <Border Height="1" Background="#FF9800" Opacity="0.4" Margin="0,0,0,4"/>

                                            <ItemsControl ItemsSource="{Binding Rows}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate DataType="{x:Type models:MaterialRow}">
                                                        <Grid Margin="0,2,0,2">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="80"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <TextBox Text="{Binding Material, UpdateSourceTrigger=PropertyChanged}"
                                                                     FontSize="11"/>
                                                            <TextBox Grid.Column="1" Text="{Binding Amount, UpdateSourceTrigger=PropertyChanged}"
                                                                     FontSize="11" Margin="4,0"/>
                                                            <Button Grid.Column="2" Content="X" Padding="4,2" FontSize="10"
                                                                    Background="{StaticResource DeleteBrush}"
                                                                    Command="{Binding DataContext.RemoveMaterialRowCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                    CommandParameter="{Binding}"/>
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>

                <!-- Footer: Save / Revert buttons + status -->
                <Grid Grid.Row="3" Margin="15,5,15,10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Progress -->
                    <ProgressBar Grid.Row="0" Value="{Binding BuildProgress}" Maximum="1" Height="6"
                                 Margin="0,0,0,5"
                                 Visibility="{Binding IsBuilding, Converter={StaticResource BoolToVisibilityConverter}}"/>

                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Content="Revert" Command="{Binding RevertItemCommand}"
                                Padding="12,6" FontSize="12" Margin="0,0,6,0"
                                Background="{StaticResource ButtonInactiveBrush}"
                                Visibility="{Binding ShowPlaceholder, Converter={StaticResource InverseBoolToVisibilityConverter}}"/>
                        <Button Grid.Column="1" Content="Save Changes" Command="{Binding SaveItemCommand}"
                                Padding="12,6" FontSize="12"
                                Background="{StaticResource BuildBrush}"
                                Visibility="{Binding ShowPlaceholder, Converter={StaticResource InverseBoolToVisibilityConverter}}"/>
                        <TextBlock Grid.Column="2" Text="{Binding BuildStatus}" FontSize="11"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   VerticalAlignment="Center" Margin="10,0,0,0"
                                   TextTrimming="CharacterEllipsis"/>
                    </Grid>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
