<UserControl x:Class="MoriaMODCreator.Views.DefCreatorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:MoriaMODCreator.ViewModels"
             d:DataContext="{d:DesignInstance vm:DefCreatorViewModel}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             Background="{StaticResource BackgroundBrush}">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="20,15,20,15" MaxWidth="900" HorizontalAlignment="Stretch">

            <!-- Title -->
            <TextBlock Text="Create DEF Files" FontSize="18" FontWeight="Bold"
                       Foreground="{StaticResource TextBrush}" Margin="0,0,0,10"/>
            <TextBlock Text="Compare modded files against originals and generate .def files."
                       FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"
                       Margin="0,0,0,15"/>

            <!-- Folder Selection -->
            <TextBlock Text="Folder Selection" FontSize="13" FontWeight="Bold"
                       Foreground="{StaticResource TextBrush}" Margin="0,0,0,6"/>
            <Border Height="1" Background="{StaticResource TextSecondaryBrush}" Opacity="0.3" Margin="0,0,0,8"/>

            <Grid Margin="0,0,0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="110"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Modded files:" FontSize="11" VerticalAlignment="Center"
                           Foreground="{StaticResource TextSecondaryBrush}"/>
                <TextBox Grid.Column="1" Text="{Binding ModFolderPath}" FontSize="11" IsReadOnly="True"/>
                <Button Grid.Column="2" Content="Browse..." Command="{Binding BrowseModFolderCommand}"
                        Padding="10,4" FontSize="11" Margin="6,0,0,0"/>
            </Grid>

            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="110"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Original files:" FontSize="11" VerticalAlignment="Center"
                           Foreground="{StaticResource TextSecondaryBrush}"/>
                <TextBox Grid.Column="1" Text="{Binding OrigFolderPath}" FontSize="11" IsReadOnly="True"/>
                <Button Grid.Column="2" Content="Browse..." Command="{Binding BrowseOrigFolderCommand}"
                        Padding="10,4" FontSize="11" Margin="6,0,0,0"/>
            </Grid>

            <!-- DEF File Metadata -->
            <TextBlock Text="DEF File Metadata" FontSize="13" FontWeight="Bold"
                       Foreground="{StaticResource TextBrush}" Margin="0,4,0,6"/>
            <Border Height="1" Background="{StaticResource TextSecondaryBrush}" Opacity="0.3" Margin="0,0,0,8"/>

            <Grid Margin="0,0,0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="110"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Title:" FontSize="11" VerticalAlignment="Center"
                           Foreground="{StaticResource TextSecondaryBrush}"/>
                <TextBox Grid.Column="1" Text="{Binding DefTitle, UpdateSourceTrigger=PropertyChanged}" FontSize="11"/>
            </Grid>

            <Grid Margin="0,0,0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="110"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Author:" FontSize="11" VerticalAlignment="Center"
                           Foreground="{StaticResource TextSecondaryBrush}"/>
                <TextBox Grid.Column="1" Text="{Binding DefAuthor, UpdateSourceTrigger=PropertyChanged}" FontSize="11"/>
            </Grid>

            <Grid Margin="0,0,0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="110"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Description:" FontSize="11" VerticalAlignment="Center"
                           Foreground="{StaticResource TextSecondaryBrush}"/>
                <TextBox Grid.Column="1" Text="{Binding DefDescription, UpdateSourceTrigger=PropertyChanged}" FontSize="11"/>
            </Grid>

            <Grid Margin="0,0,0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="110"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Change Note:" FontSize="11" VerticalAlignment="Center"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           ToolTip="Default note applied to each change"/>
                <TextBox Grid.Column="1" Text="{Binding DefChangeNote, UpdateSourceTrigger=PropertyChanged}" FontSize="11"/>
            </Grid>

            <CheckBox Content="Include comments in generated .def files"
                      IsChecked="{Binding IncludeComments}" FontSize="11"
                      Margin="0,6,0,12" Foreground="{StaticResource TextBrush}"/>

            <!-- Action Buttons -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                <Button Content="Scan &amp; Compare" Command="{Binding ScanAndCompareCommand}"
                        Background="{StaticResource ImportBrush}" Padding="14,6" FontSize="12"
                        Margin="0,0,8,0"/>
                <Button Content="Save All .def Files" Command="{Binding SaveAllFilesCommand}"
                        Background="{StaticResource BuildBrush}" Padding="14,6" FontSize="12"/>
            </StackPanel>

            <!-- Log -->
            <TextBlock Text="Log" FontSize="13" FontWeight="Bold"
                       Foreground="{StaticResource TextBrush}" Margin="0,4,0,6"/>
            <Border Height="1" Background="{StaticResource TextSecondaryBrush}" Opacity="0.3" Margin="0,0,0,8"/>
            <TextBox Text="{Binding LogText, Mode=OneWay}" IsReadOnly="True"
                     AcceptsReturn="True" TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto" Height="160"
                     FontFamily="Consolas" FontSize="10"
                     Background="{StaticResource BackgroundBrush}"
                     Foreground="{StaticResource TextSecondaryBrush}"/>

            <!-- Preview -->
            <TextBlock Text="Preview" FontSize="13" FontWeight="Bold"
                       Foreground="{StaticResource TextBrush}" Margin="0,12,0,6"/>
            <Border Height="1" Background="{StaticResource TextSecondaryBrush}" Opacity="0.3" Margin="0,0,0,8"/>

            <Grid Margin="0,0,0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="110"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="File:" FontSize="11" VerticalAlignment="Center"
                           Foreground="{StaticResource TextSecondaryBrush}"/>
                <ComboBox Grid.Column="1" ItemsSource="{Binding GeneratedFiles}"
                          SelectedItem="{Binding SelectedGeneratedFile}"
                          DisplayMemberPath="FileName" FontSize="11"/>
            </Grid>

            <TextBox Text="{Binding DefOutput, UpdateSourceTrigger=PropertyChanged}"
                     AcceptsReturn="True" TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto" Height="350"
                     FontFamily="Consolas" FontSize="11"
                     Background="{StaticResource BackgroundBrush}"
                     Foreground="{StaticResource TextBrush}"/>

            <!-- Progress + Status -->
            <ProgressBar Value="{Binding Progress}" Maximum="1" Height="6" Margin="0,10,0,0"
                         Visibility="{Binding IsWorking, Converter={StaticResource BoolToVisibilityConverter}}"/>
            <TextBlock Text="{Binding Status}" FontSize="11"
                       Foreground="{StaticResource TextSecondaryBrush}" Margin="0,6,0,0"/>

        </StackPanel>
    </ScrollViewer>
</UserControl>
