<UserControl x:Class="MoriaMODCreator.Views.DefinitionsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:MoriaMODCreator.ViewModels"
             d:DataContext="{d:DesignInstance vm:DefinitionsViewModel}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             Background="{StaticResource BackgroundBrush}">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*" MinWidth="200"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="3*"/>
        </Grid.ColumnDefinitions>

        <!-- ===== LEFT PANE: Definition File List ===== -->
        <Border Grid.Column="0" Background="{StaticResource SurfaceBrush}"
                CornerRadius="6" Margin="0,0,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Header -->
                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="10,10,10,5">
                    <CheckBox Content="" VerticalAlignment="Center" Margin="0,0,8,0"
                              IsChecked="{Binding SelectAllChecked}"/>
                    <TextBlock Text="Mod Definition" FontSize="14" FontWeight="Bold"
                               Foreground="{StaticResource TextBrush}" VerticalAlignment="Center"/>
                    <Button Content="&#x21BB;" Command="{Binding RefreshListCommand}"
                            Margin="10,0,0,0" Padding="6,3" FontSize="14"
                            Background="Transparent" ToolTip="Refresh"/>
                </StackPanel>

                <!-- Search bar with clear button -->
                <Grid Grid.Row="1" Margin="10,0,10,5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" FontSize="11"/>
                    <Button Grid.Column="1" Content="&#x2715;" Padding="4,2" FontSize="10"
                            Background="Transparent" Margin="2,0,0,0" ToolTip="Clear search"
                            Click="OnClearSearch"/>
                </Grid>

                <!-- Definition list -->
                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Margin="5,0">
                    <ItemsControl ItemsSource="{Binding FilteredEntries}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource ListItemBorder}" Margin="0,1">
                                    <Border.InputBindings>
                                        <MouseBinding MouseAction="LeftClick"
                                                      Command="{Binding DataContext.ClickEntryCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                      CommandParameter="{Binding}"/>
                                    </Border.InputBindings>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <CheckBox Grid.Column="0" IsChecked="{Binding IsChecked}"
                                                  VerticalAlignment="Center" Margin="0,0,6,0"/>
                                        <TextBlock Grid.Column="1" Text="&#x1F4C1; " FontSize="14"
                                                   VerticalAlignment="Center"
                                                   Visibility="{Binding IsDirectory, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                        <TextBlock Grid.Column="2" Text="{Binding Name}" FontSize="13"
                                                   Foreground="#FFD700" VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <Button Grid.Column="3" Content="&#x1F5D1;"
                                                Background="{StaticResource DeleteBrush}"
                                                Padding="5,2" FontSize="10"
                                                Command="{Binding DataContext.DeleteEntryCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}"
                                                Visibility="{Binding IsDirectory, Converter={StaticResource InverseBoolToVisibilityConverter}}"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <!-- Count -->
                <TextBlock Grid.Row="3" Margin="10,2,10,2" FontSize="10"
                           Foreground="{StaticResource TextSecondaryBrush}">
                    <TextBlock.Text>
                        <MultiBinding StringFormat="{}{0} definitions">
                            <Binding Path="FilteredEntries.Count"/>
                        </MultiBinding>
                    </TextBlock.Text>
                </TextBlock>

                <!-- Bottom: Mod name + Build -->
                <Grid Grid.Row="4" Margin="10,5,10,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Content="My Mod Name"
                            Background="{StaticResource AccentBrush}"
                            Command="{Binding ChooseModNameCommand}"
                            Padding="10,6" FontSize="12"/>
                    <TextBox Grid.Column="1" Text="{Binding ModName, UpdateSourceTrigger=PropertyChanged}"
                             Margin="6,0" VerticalAlignment="Center" FontSize="12"/>
                    <Button Grid.Column="2" Content="Build"
                            Background="{StaticResource BuildBrush}"
                            Command="{Binding BuildCommand}" Padding="14,6" FontSize="12"/>
                </Grid>
            </Grid>
        </Border>

        <!-- Resizable splitter -->
        <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Center"
                      VerticalAlignment="Stretch" Background="Transparent" Cursor="SizeWE"/>

        <!-- ===== RIGHT PANE: Definition Details / Change Cards ===== -->
        <Border Grid.Column="2" Background="{StaticResource SurfaceBrush}"
                CornerRadius="6" Margin="5,0,0,0">
            <Grid Margin="15">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Placeholder -->
                <TextBlock Grid.Row="2" Text="Select a .def file to view its changes."
                           FontSize="14" Foreground="{StaticResource TextSecondaryBrush}"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Visibility="{Binding ShowPlaceholder, Converter={StaticResource BoolToVisibilityConverter}}"/>

                <!-- Selected def title and metadata -->
                <StackPanel Grid.Row="0" Margin="0,0,0,10"
                            Visibility="{Binding ShowPlaceholder, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                    <TextBlock Text="{Binding SelectedTitle}" FontSize="20" FontWeight="Bold"
                               Foreground="{StaticResource TextBrush}"/>
                    <TextBlock Text="{Binding SelectedAuthor}" FontSize="13"
                               Foreground="{StaticResource TextSecondaryBrush}" Margin="0,3,0,0"/>
                    <TextBlock Text="{Binding SelectedDescription}" FontSize="12"
                               Foreground="{StaticResource TextSecondaryBrush}" Margin="0,3,0,0"
                               TextWrapping="Wrap"/>
                    <Border Height="1" Background="{StaticResource TextSecondaryBrush}"
                            Margin="0,8,0,0" Opacity="0.3"/>
                </StackPanel>

                <!-- Build progress -->
                <StackPanel Grid.Row="1" Margin="0,0,0,10"
                            Visibility="{Binding IsBuilding, Converter={StaticResource BoolToVisibilityConverter}}">
                    <ProgressBar Value="{Binding BuildProgress}" Maximum="1"/>
                    <TextBlock Text="{Binding BuildStatus}" FontSize="12"
                               Foreground="{StaticResource TextSecondaryBrush}" Margin="0,3,0,0"/>
                </StackPanel>

                <!-- Change cards display -->
                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto"
                              Visibility="{Binding ShowPlaceholder, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                    <ItemsControl ItemsSource="{Binding ChangeCards}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource BackgroundBrush}"
                                        CornerRadius="4" Padding="10" Margin="0,0,0,6">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <!-- Card header: type badge + editable item name (Gap #10) -->
                                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,4">
                                            <Border Background="{Binding CardColor}" CornerRadius="3"
                                                    Padding="6,2" Margin="0,0,8,0">
                                                <TextBlock Text="{Binding ChangeType}" FontSize="10"
                                                           FontWeight="Bold" Foreground="White"/>
                                            </Border>
                                            <TextBox Text="{Binding ItemName, UpdateSourceTrigger=PropertyChanged}"
                                                     FontSize="12" FontWeight="Bold" Foreground="#FFD700"
                                                     Background="Transparent" BorderThickness="0,0,0,1"
                                                     BorderBrush="#555" MinWidth="150"
                                                     VerticalAlignment="Center"/>
                                        </StackPanel>

                                        <!-- Editable property name -->
                                        <Grid Grid.Row="1" Margin="0,0,0,3">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBox Text="{Binding PropertyName, UpdateSourceTrigger=PropertyChanged}"
                                                     FontSize="11" FontWeight="SemiBold"
                                                     Foreground="{StaticResource TextSecondaryBrush}"
                                                     Background="Transparent" BorderThickness="0,0,0,1"
                                                     BorderBrush="#444"/>
                                            <TextBlock Grid.Column="1" FontSize="10" Foreground="#888" Margin="6,0,0,0"
                                                       VerticalAlignment="Center">
                                                <Run Text="in "/>
                                                <Run Text="{Binding FileName}"/>
                                            </TextBlock>
                                        </Grid>

                                        <!-- Editable values (Gap #10) -->
                                        <Grid Grid.Row="2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="Original:" FontSize="10"
                                                           Foreground="{StaticResource TextSecondaryBrush}"/>
                                                <TextBox Text="{Binding OldValue, UpdateSourceTrigger=PropertyChanged}"
                                                         FontSize="11" Foreground="#ef9a9a" FontFamily="Consolas"
                                                         Background="Transparent" BorderThickness="0,0,0,1"
                                                         BorderBrush="#444" TextWrapping="Wrap"/>
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" Text="  &#x2192;  "
                                                       FontSize="14" Foreground="{StaticResource TextSecondaryBrush}"
                                                       VerticalAlignment="Center"/>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="New:" FontSize="10"
                                                           Foreground="{StaticResource TextSecondaryBrush}"/>
                                                <TextBox Text="{Binding NewValue, UpdateSourceTrigger=PropertyChanged}"
                                                         FontSize="11" Foreground="#a5d6a7" FontFamily="Consolas"
                                                         Background="Transparent" BorderThickness="0,0,0,1"
                                                         BorderBrush="#444" TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </Grid>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <!-- Footer: Save + Status -->
                <Grid Grid.Row="3" Margin="0,5,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button Content="Save Changes" Command="{Binding SaveCardChangesCommand}"
                            Padding="12,6" FontSize="12" Background="{StaticResource BuildBrush}"
                            Visibility="{Binding ShowPlaceholder, Converter={StaticResource InverseBoolToVisibilityConverter}}"/>
                    <TextBlock Grid.Column="1" Text="{Binding BuildStatus}" FontSize="12"
                               Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"
                               Margin="10,0,0,0"/>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
