<UserControl x:Class="MoriaMODCreator.Views.ObjectEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:MoriaMODCreator.ViewModels"
             xmlns:models="clr-namespace:MoriaMODCreator.Models"
             xmlns:conv="clr-namespace:MoriaMODCreator.Converters"
             d:DataContext="{d:DesignInstance vm:ObjectEditorViewModel}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             Background="{StaticResource BackgroundBrush}">

    <UserControl.Resources>
        <conv:NullTooltipConverter x:Key="NullTooltipConverter"/>
        <conv:StringToBrushConverter x:Key="StringToBrushConverter"/>

        <!-- Template selector for form fields -->
        <conv:FormFieldTemplateSelector x:Key="FieldTemplateSelector">
            <!-- Section Header -->
            <conv:FormFieldTemplateSelector.SectionHeaderTemplate>
                <DataTemplate DataType="{x:Type models:FormField}">
                    <StackPanel Margin="0,12,0,4">
                        <TextBlock Text="{Binding Label}" FontSize="14" FontWeight="Bold"
                                   Foreground="{Binding SectionColor}" Margin="0,0,0,3"/>
                        <Border Height="1" Background="{Binding SectionColor}" Opacity="0.5"/>
                    </StackPanel>
                </DataTemplate>
            </conv:FormFieldTemplateSelector.SectionHeaderTemplate>

            <!-- Text Field -->
            <conv:FormFieldTemplateSelector.TextFieldTemplate>
                <DataTemplate DataType="{x:Type models:FormField}">
                    <Grid Margin="0,3,0,3">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="180"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding Label}" FontSize="12"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   VerticalAlignment="Center"
                                   ToolTip="{Binding Tooltip, Converter={StaticResource NullTooltipConverter}}"/>
                        <TextBox Grid.Column="1" Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                                 FontSize="12" IsReadOnly="{Binding IsReadOnly}"/>
                    </Grid>
                </DataTemplate>
            </conv:FormFieldTemplateSelector.TextFieldTemplate>

            <!-- Dropdown Field -->
            <conv:FormFieldTemplateSelector.DropdownFieldTemplate>
                <DataTemplate DataType="{x:Type models:FormField}">
                    <Grid Margin="0,3,0,3">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="180"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding Label}" FontSize="12"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   VerticalAlignment="Center"
                                   ToolTip="{Binding Tooltip, Converter={StaticResource NullTooltipConverter}}"/>
                        <ComboBox Grid.Column="1" Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                                  ItemsSource="{Binding Options}" IsEditable="True" FontSize="12"/>
                    </Grid>
                </DataTemplate>
            </conv:FormFieldTemplateSelector.DropdownFieldTemplate>

            <!-- Checkbox Field -->
            <conv:FormFieldTemplateSelector.CheckboxFieldTemplate>
                <DataTemplate DataType="{x:Type models:FormField}">
                    <CheckBox Content="{Binding Label}" FontSize="12"
                              Foreground="{StaticResource TextBrush}"
                              Margin="0,2,12,2" ToolTip="{Binding Tooltip, Converter={StaticResource NullTooltipConverter}}">
                        <CheckBox.IsChecked>
                            <Binding Path="Value" UpdateSourceTrigger="PropertyChanged">
                                <Binding.Converter>
                                    <conv:StringToBoolConverter/>
                                </Binding.Converter>
                            </Binding>
                        </CheckBox.IsChecked>
                    </CheckBox>
                </DataTemplate>
            </conv:FormFieldTemplateSelector.CheckboxFieldTemplate>

            <!-- Inline Row (multiple fields horizontally) -->
            <conv:FormFieldTemplateSelector.InlineRowTemplate>
                <DataTemplate DataType="{x:Type models:FormField}">
                    <ItemsControl ItemsSource="{Binding InlineFields}" Margin="0,3,0,3">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Rows="1"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type models:FormField}">
                                <StackPanel Margin="0,0,8,0">
                                    <TextBlock Text="{Binding Label}" FontSize="10"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               ToolTip="{Binding Tooltip, Converter={StaticResource NullTooltipConverter}}"/>
                                    <TextBox Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                                             FontSize="12" Margin="0,2,0,0"/>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </DataTemplate>
            </conv:FormFieldTemplateSelector.InlineRowTemplate>

            <!-- ReadOnly Field -->
            <conv:FormFieldTemplateSelector.ReadOnlyFieldTemplate>
                <DataTemplate DataType="{x:Type models:FormField}">
                    <Grid Margin="0,3,0,3">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="180"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding Label}" FontSize="12"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   VerticalAlignment="Center"
                                   ToolTip="{Binding Tooltip, Converter={StaticResource NullTooltipConverter}}"/>
                        <TextBox Grid.Column="1" Text="{Binding Value}" FontSize="12"
                                 IsReadOnly="True" Opacity="0.7"/>
                    </Grid>
                </DataTemplate>
            </conv:FormFieldTemplateSelector.ReadOnlyFieldTemplate>
        </conv:FormFieldTemplateSelector>
    </UserControl.Resources>

    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*" MinWidth="200"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="3*"/>
        </Grid.ColumnDefinitions>

        <!-- ===== LEFT PANE ===== -->
        <Border Grid.Column="0" Background="{StaticResource SurfaceBrush}"
                CornerRadius="6" Margin="0,0,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>  <!-- Header label -->
                    <RowDefinition Height="Auto"/>  <!-- Category buttons -->
                    <RowDefinition Height="Auto"/>  <!-- + New Item button -->
                    <RowDefinition Height="*"/>     <!-- Item list -->
                    <RowDefinition Height="Auto"/>  <!-- Search bar -->
                    <RowDefinition Height="Auto"/>  <!-- Count -->
                    <RowDefinition Height="Auto"/>  <!-- Mod name + Build footer -->
                </Grid.RowDefinitions>

                <!-- Header -->
                <TextBlock Grid.Row="0" Text="Create / Edit Secret" FontSize="14" FontWeight="Bold"
                           Foreground="{StaticResource TextBrush}" Margin="10,10,10,5"/>

                <!-- Category buttons with per-category colors -->
                <StackPanel Grid.Row="1" Margin="5,0,5,5">
                    <WrapPanel>
                        <Button Content="Buildings" Command="{Binding SelectCategoryCommand}" CommandParameter="Buildings"
                                Margin="2" Padding="8,4" FontSize="11" Background="#795548"/>
                        <Button Content="Weapons" Command="{Binding SelectCategoryCommand}" CommandParameter="Weapons"
                                Margin="2" Padding="8,4" FontSize="11" Background="#E65100"/>
                        <Button Content="Armor" Command="{Binding SelectCategoryCommand}" CommandParameter="Armor"
                                Margin="2" Padding="8,4" FontSize="11" Background="#1565C0"/>
                    </WrapPanel>
                    <WrapPanel>
                        <Button Content="Tools" Command="{Binding SelectCategoryCommand}" CommandParameter="Tools"
                                Margin="2" Padding="8,4" FontSize="11" Background="#2E7D32"/>
                        <Button Content="Flora" Command="{Binding SelectCategoryCommand}" CommandParameter="Flora"
                                Margin="2" Padding="8,4" FontSize="11" Background="#388E3C"/>
                    </WrapPanel>
                    <WrapPanel>
                        <Button Content="Loot" Command="{Binding SelectCategoryCommand}" CommandParameter="Loot"
                                Margin="2" Padding="8,4" FontSize="11" Background="#F57F17"/>
                        <Button Content="Items" Command="{Binding SelectCategoryCommand}" CommandParameter="Items"
                                Margin="2" Padding="8,4" FontSize="11" Background="#6A1B9A"/>
                        <Button Content="Ores" Command="{Binding SelectCategoryCommand}" CommandParameter="Ores"
                                Margin="2" Padding="8,4" FontSize="11" Background="#795548"/>
                    </WrapPanel>
                </StackPanel>

                <!-- New Item button — prominent, green -->
                <Button Grid.Row="2" Content="+ New Item" Command="{Binding NewItemCommand}"
                        Background="{StaticResource BuildBrush}" Padding="10,6" FontSize="13"
                        Margin="10,0,10,8" FontWeight="Bold"/>

                <!-- Item list (click to select) — no checkbox, no eye icon -->
                <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" Margin="5,0">
                    <ItemsControl ItemsSource="{Binding FilteredItems}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource ListItemBorder}" Padding="4,3">
                                    <Border.InputBindings>
                                        <MouseBinding MouseAction="LeftClick"
                                                      Command="{Binding DataContext.SelectItemCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                      CommandParameter="{Binding}"/>
                                    </Border.InputBindings>
                                    <TextBlock FontSize="11" Foreground="#FFD700"
                                               Text="{Binding DisplayName}"
                                               TextTrimming="CharacterEllipsis"/>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <!-- Search bar at bottom (matching BuildingsView layout) -->
                <Grid Grid.Row="4" Margin="10,5,10,2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="&#x1F50D;" FontSize="12" VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <TextBox Grid.Column="1" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             FontSize="11" Tag="Search items..."/>
                </Grid>

                <!-- Count -->
                <TextBlock Grid.Row="5" Margin="10,0,10,2" FontSize="10"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           Text="{Binding ItemCountText}"/>

                <!-- Bottom footer: Mod name picker + Build button -->
                <StackPanel Grid.Row="6" Margin="10,0,10,10">
                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Content="Mod Name" Command="{Binding ChooseModNameCommand}"
                                Padding="6,4" FontSize="10" Background="{StaticResource AccentBrush}"/>
                        <TextBox Grid.Column="1" Text="{Binding ModName}"
                                 Margin="4,0,0,0" FontSize="11" VerticalAlignment="Center" IsReadOnly="True"/>
                    </Grid>
                    <Button Content="Build Secret Mod" Command="{Binding BuildAsyncCommand}"
                            Background="{StaticResource BuildBrush}" Padding="8,6" FontSize="12"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Resizable splitter -->
        <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Center"
                      VerticalAlignment="Stretch" Background="Transparent" Cursor="SizeWE"/>

        <!-- ===== RIGHT PANE: Form Editor ===== -->
        <Border Grid.Column="2" Background="{StaticResource SurfaceBrush}"
                CornerRadius="6" Margin="5,0,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>  <!-- Header: selected item name -->
                    <RowDefinition Height="*"/>     <!-- Form content -->
                    <RowDefinition Height="Auto"/>  <!-- Footer: Save/Revert/Status + Progress -->
                </Grid.RowDefinitions>

                <!-- Header: selected item name -->
                <Grid Grid.Row="0" Margin="15,10,15,0"
                      Visibility="{Binding ShowPlaceholder, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                    <StackPanel>
                        <TextBlock Text="{Binding SelectedItem.DisplayName}" FontSize="18" FontWeight="Bold"
                                   Foreground="#FFD700"/>
                        <TextBlock Text="{Binding SelectedItem.RowName}" FontSize="11"
                                   Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0"/>
                        <Border Height="1" Background="{StaticResource TextSecondaryBrush}"
                                Margin="0,8,0,0" Opacity="0.3"/>
                    </StackPanel>
                </Grid>

                <!-- Form content -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="15,5,15,5">
                    <Grid>
                        <!-- Placeholder when no item selected -->
                        <TextBlock Text="Select an item from the list, or click '+ New Item' to create one."
                                   FontSize="14" Foreground="{StaticResource TextSecondaryBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Margin="0,40,0,0"
                                   Visibility="{Binding ShowPlaceholder, Converter={StaticResource BoolToVisibilityConverter}}"/>

                        <!-- Form fields + material sections -->
                        <StackPanel Visibility="{Binding ShowPlaceholder, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                            <!-- Form fields via template selector -->
                            <ItemsControl ItemsSource="{Binding FormFields}"
                                          ItemTemplateSelector="{StaticResource FieldTemplateSelector}"/>

                            <!-- Material sections -->
                            <ItemsControl ItemsSource="{Binding MaterialSections}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type models:MaterialSection}">
                                        <StackPanel Margin="0,12,0,4">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="Bold"
                                                           Foreground="#FF9800" Margin="0,0,10,3"/>
                                                <Button Content="+ Add" Padding="6,2" FontSize="10"
                                                        Background="#FF9800"
                                                        Command="{Binding DataContext.AddMaterialRowCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}"/>
                                            </StackPanel>
                                            <Border Height="1" Background="#FF9800" Opacity="0.4" Margin="0,0,0,4"/>

                                            <ItemsControl ItemsSource="{Binding Rows}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate DataType="{x:Type models:MaterialRow}">
                                                        <Grid Margin="0,2,0,2">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="80"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <TextBox Text="{Binding Material, UpdateSourceTrigger=PropertyChanged}"
                                                                     FontSize="11"/>
                                                            <TextBox Grid.Column="1" Text="{Binding Amount, UpdateSourceTrigger=PropertyChanged}"
                                                                     FontSize="11" Margin="4,0"/>
                                                            <Button Grid.Column="2" Content="X" Padding="4,2" FontSize="10"
                                                                    Background="{StaticResource DeleteBrush}"
                                                                    Command="{Binding DataContext.RemoveMaterialRowCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                    CommandParameter="{Binding}"/>
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>

                <!-- Footer: Save / Revert / Progress / Status -->
                <Grid Grid.Row="2" Margin="15,5,15,10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Progress bar (shown during build) -->
                    <ProgressBar Grid.Row="0" Value="{Binding BuildProgress}" Maximum="1" Height="6"
                                 Margin="0,0,0,5"
                                 Visibility="{Binding IsBuilding, Converter={StaticResource BoolToVisibilityConverter}}"/>

                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Content="Revert" Command="{Binding RevertItemCommand}"
                                Padding="12,6" FontSize="12" Margin="0,0,6,0"
                                Background="{StaticResource ButtonInactiveBrush}"
                                Visibility="{Binding ShowPlaceholder, Converter={StaticResource InverseBoolToVisibilityConverter}}"/>
                        <Button Grid.Column="1" Content="Save Changes" Command="{Binding SaveItemCommand}"
                                Padding="12,6" FontSize="12"
                                Background="{StaticResource BuildBrush}"
                                Visibility="{Binding ShowPlaceholder, Converter={StaticResource InverseBoolToVisibilityConverter}}"/>
                        <TextBlock Grid.Column="2" Text="{Binding Status}" FontSize="11"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   VerticalAlignment="Center" Margin="10,0,0,0"
                                   TextTrimming="CharacterEllipsis"/>
                    </Grid>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
