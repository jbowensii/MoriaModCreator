<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Dark Blue theme — deep navy color palette -->
    <Color x:Key="BackgroundColor">#0d1b2a</Color>
    <Color x:Key="SurfaceColor">#1b2838</Color>
    <Color x:Key="PrimaryColor">#1565C0</Color>
    <Color x:Key="AccentColor">#42A5F5</Color>
    <Color x:Key="TextColor">#e0e0e0</Color>
    <Color x:Key="TextSecondaryColor">#a0a0a0</Color>
    <Color x:Key="ErrorColor">#ff4444</Color>
    <Color x:Key="SuccessColor">#4caf50</Color>
    <Color x:Key="WarningColor">#FFA500</Color>
    <Color x:Key="ButtonColor">#1565C0</Color>
    <Color x:Key="ButtonHoverColor">#42A5F5</Color>
    <Color x:Key="ButtonInactiveColor">#37474F</Color>
    <Color x:Key="ButtonInactiveHoverColor">#546E7A</Color>
    <Color x:Key="DeleteColor">#d32f2f</Color>
    <Color x:Key="BuildColor">#4caf50</Color>
    <Color x:Key="ImportColor">#0D47A1</Color>

    <SolidColorBrush x:Key="BackgroundBrush" Color="{StaticResource BackgroundColor}"/>
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}"/>
    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource PrimaryColor}"/>
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}"/>
    <SolidColorBrush x:Key="TextBrush" Color="{StaticResource TextColor}"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}"/>
    <SolidColorBrush x:Key="ErrorBrush" Color="{StaticResource ErrorColor}"/>
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}"/>
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}"/>
    <SolidColorBrush x:Key="ButtonBrush" Color="{StaticResource ButtonColor}"/>
    <SolidColorBrush x:Key="ButtonHoverBrush" Color="{StaticResource ButtonHoverColor}"/>
    <SolidColorBrush x:Key="ButtonInactiveBrush" Color="{StaticResource ButtonInactiveColor}"/>
    <SolidColorBrush x:Key="ButtonInactiveHoverBrush" Color="{StaticResource ButtonInactiveHoverColor}"/>
    <SolidColorBrush x:Key="DeleteBrush" Color="{StaticResource DeleteColor}"/>
    <SolidColorBrush x:Key="BuildBrush" Color="{StaticResource BuildColor}"/>
    <SolidColorBrush x:Key="ImportBrush" Color="{StaticResource ImportColor}"/>

    <Color x:Key="ListItemHoverColor">#263850</Color>
    <Color x:Key="ListItemSelectedColor">#1a3a5c</Color>
    <SolidColorBrush x:Key="ListItemHoverBrush" Color="{StaticResource ListItemHoverColor}"/>
    <SolidColorBrush x:Key="ListItemSelectedBrush" Color="{StaticResource ListItemSelectedColor}"/>

</ResourceDictionary>
