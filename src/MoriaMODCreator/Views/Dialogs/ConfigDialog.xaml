<Window x:Class="MoriaMODCreator.Views.Dialogs.ConfigDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Moria MOD Creator - Configuration"
        Height="510" Width="825"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Icon="/Assets/Icons/app_icon.ico"
        Background="{StaticResource BackgroundBrush}">

    <!-- ComboBox dark theme now handled globally in DarkTheme.xaml -->

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- Game path -->
            <RowDefinition Height="Auto"/>  <!-- Game path display -->
            <RowDefinition Height="Auto"/>  <!-- Utilities -->
            <RowDefinition Height="Auto"/>  <!-- Output -->
            <RowDefinition Height="Auto"/>  <!-- My MOD Files -->
            <RowDefinition Height="Auto"/>  <!-- Definitions -->
            <RowDefinition Height="Auto"/>  <!-- Final Destination -->
            <RowDefinition Height="Auto"/>  <!-- Color Scheme -->
            <RowDefinition Height="Auto"/>  <!-- Parallel Processes -->
            <RowDefinition Height="Auto"/>  <!-- Debug Mode -->
            <RowDefinition Height="*"/>     <!-- Spacer -->
            <RowDefinition Height="Auto"/>  <!-- Buttons -->
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="180"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <!-- Game Install Path -->
        <TextBlock Grid.Row="0" Grid.Column="0" Text="Game Install Path:" FontSize="13"
                   VerticalAlignment="Center" Margin="0,0,10,5"/>
        <ComboBox Grid.Row="0" Grid.Column="1" x:Name="GameDropdown" FontSize="12"
                  Width="300" HorizontalAlignment="Left" Margin="0,0,0,5"
                  SelectionChanged="OnGameDropdownChanged"/>
        <Button Grid.Row="0" Grid.Column="2" x:Name="GameBrowseBtn" Content="Browse..."
                Padding="12,6" FontSize="12" Click="OnBrowseGamePath" Margin="10,0,0,5"
                Visibility="Collapsed"/>

        <!-- Game path display -->
        <TextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" x:Name="GamePathLabel"
                   Text="" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}"
                   TextWrapping="Wrap" Margin="0,0,0,15"/>

        <!-- Directory rows -->
        <TextBlock Grid.Row="2" Grid.Column="0" Text="Utilities Directory:" FontSize="13"
                   VerticalAlignment="Center" Margin="0,0,10,5"/>
        <TextBox Grid.Row="2" Grid.Column="1" x:Name="UtilitiesBox" FontSize="11" Margin="0,0,0,5"/>
        <Button Grid.Row="2" Grid.Column="2" Content="Browse..." Padding="10,4" FontSize="11"
                Click="OnBrowseUtilities" Margin="10,0,0,5"/>

        <TextBlock Grid.Row="3" Grid.Column="0" Text="Output Directory:" FontSize="13"
                   VerticalAlignment="Center" Margin="0,0,10,5"/>
        <TextBox Grid.Row="3" Grid.Column="1" x:Name="OutputBox" FontSize="11" Margin="0,0,0,5"/>
        <Button Grid.Row="3" Grid.Column="2" Content="Browse..." Padding="10,4" FontSize="11"
                Click="OnBrowseOutput" Margin="10,0,0,5"/>

        <TextBlock Grid.Row="4" Grid.Column="0" Text="My MOD Files Directory:" FontSize="13"
                   VerticalAlignment="Center" Margin="0,0,10,5"/>
        <TextBox Grid.Row="4" Grid.Column="1" x:Name="MyModFilesBox" FontSize="11" Margin="0,0,0,5"/>
        <Button Grid.Row="4" Grid.Column="2" Content="Browse..." Padding="10,4" FontSize="11"
                Click="OnBrowseMyModFiles" Margin="10,0,0,5"/>

        <TextBlock Grid.Row="5" Grid.Column="0" Text="MOD Definitions Directory:" FontSize="13"
                   VerticalAlignment="Center" Margin="0,0,10,5"/>
        <TextBox Grid.Row="5" Grid.Column="1" x:Name="DefinitionsBox" FontSize="11" Margin="0,0,0,5"/>
        <Button Grid.Row="5" Grid.Column="2" Content="Browse..." Padding="10,4" FontSize="11"
                Click="OnBrowseDefinitions" Margin="10,0,0,5"/>

        <TextBlock Grid.Row="6" Grid.Column="0" Text="Final Mod(s) Destination:" FontSize="13"
                   VerticalAlignment="Center" Margin="0,0,10,5"/>
        <TextBox Grid.Row="6" Grid.Column="1" x:Name="FinalDestBox" FontSize="11" Margin="0,0,0,5"/>
        <Button Grid.Row="6" Grid.Column="2" Content="Browse..." Padding="10,4" FontSize="11"
                Click="OnBrowseFinalDest" Margin="10,0,0,5"/>

        <!-- Color Scheme -->
        <TextBlock Grid.Row="7" Grid.Column="0" Text="Color Scheme:" FontSize="13"
                   VerticalAlignment="Center" Margin="0,15,10,5"/>
        <ComboBox Grid.Row="7" Grid.Column="1" x:Name="ColorSchemeDropdown" FontSize="12"
                  Width="300" HorizontalAlignment="Left" Margin="0,15,0,5"/>

        <!-- Parallel Processes -->
        <TextBlock Grid.Row="8" Grid.Column="0" Text="Parallel Processes:" FontSize="13"
                   VerticalAlignment="Center" Margin="0,0,10,5"/>
        <StackPanel Grid.Row="8" Grid.Column="1" Orientation="Horizontal">
            <ComboBox x:Name="WorkersDropdown" FontSize="12" Width="80" Margin="0,0,10,5"/>
            <TextBlock Text="(Number of parallel processes for JSON conversion)"
                       FontSize="10" Foreground="{StaticResource TextSecondaryBrush}"
                       VerticalAlignment="Center"/>
        </StackPanel>

        <!-- Debug Mode -->
        <TextBlock Grid.Row="9" Grid.Column="0" Text="Debug Mode:" FontSize="13"
                   VerticalAlignment="Center" Margin="0,0,10,5"/>
        <StackPanel Grid.Row="9" Grid.Column="1" Orientation="Horizontal">
            <CheckBox x:Name="DebugCheck" VerticalAlignment="Center" Margin="0,0,10,5"/>
            <TextBlock Text="(Enable verbose logging for troubleshooting)"
                       FontSize="10" Foreground="{StaticResource TextSecondaryBrush}"
                       VerticalAlignment="Center"/>
        </StackPanel>

        <!-- Buttons -->
        <Grid Grid.Row="11" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" Content="CANCEL" Padding="16,8"
                    Background="{StaticResource DeleteBrush}"
                    HorizontalAlignment="Left" FontSize="13" FontWeight="Bold"
                    Click="OnCancel"/>
            <Button Grid.Column="1" Content="SAVE" Padding="16,8"
                    Background="{StaticResource BuildBrush}"
                    HorizontalAlignment="Right" FontSize="13" FontWeight="Bold"
                    Click="OnSave"/>
        </Grid>
    </Grid>
</Window>
