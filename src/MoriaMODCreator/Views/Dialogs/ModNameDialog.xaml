<Window x:Class="MoriaMODCreator.Views.Dialogs.ModNameDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Select Mod Name"
        Height="400" Width="450"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Icon="/Assets/Icons/app_icon.ico"
        Background="{StaticResource BackgroundBrush}">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Title -->
        <TextBlock Grid.Row="0" Text="My Mod Names" FontSize="16" FontWeight="Bold"
                   Foreground="{StaticResource TextBrush}" Margin="0,0,0,10"/>

        <!-- Existing mods list -->
        <Border Grid.Row="1" Background="{StaticResource SurfaceBrush}" CornerRadius="4">
            <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="5">
                <ItemsControl x:Name="ModList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0" Content="{Binding}" Padding="10,6"
                                        Background="{StaticResource ButtonInactiveBrush}"
                                        HorizontalContentAlignment="Left"
                                        Click="OnSelectMod"/>
                                <Button Grid.Column="1" Content="&#x1F5D1;" Padding="8,6"
                                        Background="{StaticResource DeleteBrush}"
                                        Click="OnDeleteMod" Margin="5,0,0,0"
                                        Tag="{Binding}"/>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <!-- New mod name entry -->
        <Grid Grid.Row="2" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox Grid.Column="0" x:Name="NewModNameBox" FontSize="13"
                     KeyDown="OnNewModKeyDown"/>
            <Button Grid.Column="1" Content="Create" Padding="14,8"
                    Background="{StaticResource BuildBrush}" Margin="8,0,0,0"
                    Click="OnCreateMod"/>
        </Grid>

        <!-- Close button -->
        <Button Grid.Row="3" Content="Close" Padding="16,8"
                HorizontalAlignment="Right" Margin="0,10,0,0"
                Click="OnClose"/>
    </Grid>
</Window>
